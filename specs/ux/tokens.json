{
  "$schema": "Design tokens for GeneratingOverlay icon system",
  "colors": {
    "primary": {
      "50": "#EEF2FF",
      "100": "#E0E7FF",
      "200": "#C7D2FE",
      "400": "#818CF8",
      "500": "#6366F1",
      "600": "#4F46E5",
      "700": "#4338CA",
      "800": "#3730A3"
    },
    "violet": {
      "400": "#A78BFA",
      "500": "#8B5CF6",
      "600": "#7C3AED"
    },
    "success": {
      "400": "#34D399",
      "500": "#10B981",
      "600": "#059669",
      "glow": "rgba(16, 185, 129, 0.4)"
    },
    "info": {
      "400": "#22D3EE",
      "500": "#06B6D4"
    },
    "neutral": {
      "100": "#F5F3F0",
      "200": "#E7E5E4",
      "400": "#A8A29E",
      "500": "#78716C",
      "700": "#44403C",
      "900": "#1C1917"
    }
  },
  "gradients": {
    "iconPrimary": "linear-gradient(135deg, #6366F1 0%, #8B5CF6 100%)",
    "iconPrimarySoft": "linear-gradient(135deg, rgba(99,102,241,0.15) 0%, rgba(139,92,246,0.10) 100%)",
    "iconSuccess": "linear-gradient(135deg, #10B981 0%, #34D399 100%)",
    "iconSuccessSoft": "linear-gradient(135deg, rgba(16,185,129,0.12) 0%, rgba(52,211,153,0.08) 100%)",
    "iconInfo": "linear-gradient(135deg, #06B6D4 0%, #22D3EE 100%)",
    "iconInfoSoft": "linear-gradient(135deg, rgba(6,182,212,0.12) 0%, rgba(34,211,238,0.08) 100%)",
    "ringTrack": "conic-gradient(from 0deg, rgba(99,102,241,0.08) 0%, rgba(99,102,241,0.04) 100%)",
    "scanLine": "linear-gradient(90deg, transparent 0%, #818CF8 20%, #6366F1 50%, #818CF8 80%, transparent 100%)",
    "glowPrimary": "radial-gradient(circle, rgba(99,102,241,0.30) 0%, rgba(139,92,246,0.15) 50%, transparent 70%)",
    "glowSuccess": "radial-gradient(circle, rgba(16,185,129,0.35) 0%, rgba(52,211,153,0.15) 50%, transparent 70%)"
  },
  "iconSize": {
    "container": {
      "default": "80px",
      "mobile": "72px"
    },
    "icon": {
      "default": "36px",
      "mobile": "32px"
    },
    "ring": {
      "outer": "80px",
      "strokeWidth": "3.5",
      "trackStroke": "2"
    },
    "glow": "120px",
    "particle": "4px"
  },
  "animation": {
    "timing": {
      "scanDuration": "2.4s",
      "rippleDuration": "2.8s",
      "ringRotate": "8s",
      "pulseGlow": "2.5s",
      "particleDrift": "3s",
      "morphFloat": "6s",
      "bounceIn": "0.6s",
      "floatSoft": "3.5s"
    },
    "easing": {
      "smooth": "cubic-bezier(0.16, 1, 0.3, 1)",
      "bounce": "cubic-bezier(0.34, 1.56, 0.64, 1)",
      "elastic": "cubic-bezier(0.68, -0.55, 0.265, 1.55)",
      "easeOut": "cubic-bezier(0.25, 0.46, 0.45, 0.94)"
    },
    "delay": {
      "stagger": "0.15s",
      "particle1": "0s",
      "particle2": "0.8s",
      "particle3": "1.6s",
      "particle4": "2.2s"
    }
  },
  "responsive": {
    "mobile": {
      "breakpoint": "max-width: 767px",
      "iconContainer": "72px",
      "iconSize": "32px",
      "titleSize": "16px",
      "subtitleSize": "12px"
    },
    "tablet": {
      "breakpoint": "768px - 1279px",
      "iconContainer": "80px",
      "iconSize": "36px",
      "titleSize": "18px",
      "subtitleSize": "13px"
    },
    "desktop": {
      "breakpoint": "min-width: 1280px",
      "iconContainer": "88px",
      "iconSize": "40px",
      "titleSize": "19px",
      "subtitleSize": "14px"
    }
  }
}
