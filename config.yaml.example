# 用友产业案例教学课程定制系统 - 配置文件模板
# 复制此文件为 config.yaml 并修改配置

server:
  host: "0.0.0.0"
  port: 8000
  timezone: "" # IANA 时区名，如 "Asia/Shanghai"；留空则跟随服务器系统时区
  cors_origins:
    - "http://localhost:5173"
    - "http://yonyou-caseedu.hongyaa.com.cn"

database:
  url: "postgresql://postgres:postgres@localhost:5432/yonyou_case"

admin:
  username: "admin"
  password: "changeme"  # 首次启动后建议修改
  jwt_secret: "change-me-in-production"
  token_expire_hours: 4  # 登录Token过期时间（小时），范围 1-720，默认4小时

llm:
  api_key: "sk-xxx"
  api_base_url: "https://api.openai.com/v1"
  model: "gpt-4o"
  temperature: 0.7
  max_tokens: 2000
  timeout: 60

pricing:
  rate_per_hour: 2000

# 速率限制配置（优先级低于管理后台设置，仅作为数据库无记录时的 fallback）
rate_limit:
  generate_max_requests: 10       # 每小时最大生成次数（per IP）
  generate_window_seconds: 3600   # 滑动窗口时长（秒）
  generate_cooldown_seconds: 30   # 两次请求最小间隔（秒）
  max_concurrent: 3               # 同时进行的最大 LLM 请求数（全局）

frontend:
  title: "用友产业案例教学项目课程定制系统"
